{
  "version": "1.0",
  "description": "S4_LDN Policy Backtest Configuration",
  
  "paths": {
    "enriched_trades": "asm_v2/artifacts/gc_m1/s4_ldn_trades_enriched_v1.jsonl",
    "output_dir": "asm_v2/artifacts/s4_policy/gc_m1"
  },
  
  "backtest": {
    "min_trades_for_valid_policy": 1,
    "sort_by": "expectancy"
  },
  
  "policies": [
    {
      "name": "P0_baseline_all",
      "policy_type": "baseline",
      "params": {}
    },
    {
      "name": "P1_regime_trend_down",
      "policy_type": "regime_only",
      "params": {
        "regimes": ["trend_down"]
      }
    },
    {
      "name": "P2_regime_trend_up",
      "policy_type": "regime_only",
      "params": {
        "regimes": ["trend_up"]
      }
    },
    {
      "name": "P3_regime_no_balance",
      "policy_type": "regime_exclude",
      "params": {
        "exclude_regimes": ["balance"]
      }
    },
    {
      "name": "P4_session_ldn",
      "policy_type": "session",
      "params": {
        "sessions": ["LDN"]
      }
    },
    {
      "name": "P5_session_asia",
      "policy_type": "session",
      "params": {
        "sessions": ["Asia", "ASIA"]
      }
    },
    {
      "name": "P6_direction_aligned",
      "policy_type": "direction_regime",
      "params": {
        "strict": true,
        "allow_balance": false
      }
    },
    {
      "name": "P7_direction_aligned_balance",
      "policy_type": "direction_regime",
      "params": {
        "strict": true,
        "allow_balance": true
      }
    },
    {
      "name": "P8_combo_trend_ldn",
      "policy_type": "combo",
      "params": {
        "regimes": ["trend_down", "trend_up"],
        "sessions": ["LDN"]
      }
    },
    {
      "name": "P9_combo_trend_down_mid",
      "policy_type": "combo",
      "params": {
        "regimes": ["trend_down"],
        "pos_range": [0.2, 0.8]
      }
    },
    {
      "name": "P10_short_trend_down",
      "policy_type": "combo",
      "params": {
        "regimes": ["trend_down"],
        "directions": ["short"]
      }
    },
    {
      "name": "P11_long_trend_up",
      "policy_type": "combo",
      "params": {
        "regimes": ["trend_up"],
        "directions": ["long"]
      }
    }
  ],
  
  "meta_model": {
    "enabled": true,
    "thresholds": [0.4, 0.5, 0.6, 0.7]
  }
}
